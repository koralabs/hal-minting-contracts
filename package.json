{
  "name": "@koralabs/hal-minting-contracts",
  "version": "1.2.26",
  "license": "MIT",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "build": "rm -rf lib/ && tsc",
    "lint": "npx eslint './src/**/*.{ts,mjs}' --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "start:mainnet": "cd scripts/ && NODE_ENV=mainnet NETWORK=mainnet tsx ./run/index.ts",
    "start:preview": "cd scripts/ && NODE_ENV=preview tsx ./run/index.ts",
    "start:preprod": "cd scripts/ && NODE_ENV=preprod tsx ./run/index.ts"
  },
  "dependencies": {
    "@aiken-lang/merkle-patricia-forestry": "1.3.1",
    "@blockfrost/blockfrost-js": "6.0.0",
    "@helios-lang/codec-utils": "0.3.4",
    "@helios-lang/compiler": "0.17.30",
    "@helios-lang/crypto": "0.2.3",
    "@helios-lang/ledger": "0.7.19",
    "@helios-lang/tx-utils": "0.6.27",
    "@helios-lang/uplc": "0.7.18",
    "@koralabs/kora-labs-common": "6.3.0",
    "ansi-colors": "4.1.3",
    "cli-progress": "3.12.0",
    "cross-fetch": "4.1.0",
    "dotenv": "17.2.1",
    "flatted": "3.3.3",
    "prompts": "2.4.2",
    "ts-res": "1.3.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/cli-progress": "3.11.6",
    "@types/node": "22.18.1",
    "@types/prompts": "2.4.9",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "16.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.41.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "minimatch": "10.2.2"
  }
}
